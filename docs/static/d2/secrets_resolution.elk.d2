# https://d2lang.com diagram. Use make update-diagrams to generate SVG; the layout engine is the suffix in the file name.
direction: down

uses: {
  label: "Secret references"
  param: "App params\n--param KEY='{{secret \"MY_KEY\"}}'"
  config: "Server config\nOAuth client secrets,\nservice urls, git auth"
  plugin: "Plugin arguments\nheaders, urls"
}

openrun: {
  label: "OpenRun server"
  style: {stroke-width: 2}
  resolve: "Resolved when used\nsecret_from picks a provider,\nsecret uses the default"
}

providers: {
  label: "Providers [secret.<name>]"
  grid-columns: 3
  grid-gap: 20
  asm: "AWS Secrets Manager\nasm, asm_*"
  ssm: "AWS SSM\nssm, ssm_*"
  vault: "HashiCorp Vault\nvault, vault_*"
  k8s: "Kubernetes Secrets\nkubernetes, kubernetes_*"
  db: "Embedded store\ndb, encrypted in metadata"
  env: "env and prop\ndev and testing"
}

uses.param -> openrun.resolve
uses.config -> openrun.resolve
uses.plugin -> openrun.resolve
openrun.resolve -> providers
